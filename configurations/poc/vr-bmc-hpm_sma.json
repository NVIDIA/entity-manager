[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-bmc'})",
    "Type": "Device_Configs",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {}
      }
    ]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-bmc'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x0955:0xcf11:$Port",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": true
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-bmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "BridgePoolStartEID": "$PoolStartEID",
        "Configuration": 1,
        "IgnoreMessageTypes": "1,5",
        "InterfaceNum": 0,
        "Name": "SMA_$Instance",
        "PollingInterval": "5",
        "Port": "$Port",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      }
    ]
  }
]
