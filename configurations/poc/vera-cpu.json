  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cpu$', 'Generation': 'vera'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "CPU",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x0955:0x7410:$Port",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": false
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cpu$', 'Generation': 'vera'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "DeviceType": "CPU_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "CPUDiag"
        ],
        "Type": "Dump"
      },
      {
        "Configuration": 1,
        "InterfaceNum": 2,
        "Name": "$Name",
        "PollingInterval": "5",
        "Port": "$Port",
        "RecoveryThreshold": "5",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/component/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 2,
            "Name": "$Platform.NamePrefixSBIOS_FMC_$Instance"
          },
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/component/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 513,
            "Name": "$Platform.NamePrefixSBIOS_FW_$Instance"
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  },
  {
    "Name": "$Name_USBRCM_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cpu$', 'Generation': 'vera'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "FMCComponentName": "$Platform.NamePrefixSBIOS_FMC_$Instance",
        "FWSComponentName": "$Platform.NamePrefixSBIOS_FW_$Instance",
        "MctpEID": "$EID",
        "Name": "$Platform.NamePrefixFW_CPU_$Instance",
        "Type": "USBRCMRecovery",
        "USBPort": "1-$Port",
        "hasChassisPowerSource": true
      }
    ]
  }
