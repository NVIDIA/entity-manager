[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-hmc'})",
    "Type": "Device_Configs",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {  
      "Name": "NSM_Telemetry",
      "Type": "NSM_Telemetry",
      "Disable": [],
      "ParameterOverrides": {
        "TotalGpuPower": {
          "enabled": "$TGP_ENABLED",
          "GPU_Count": "$TGP_GPU_COUNT"
        }
      }
    }]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-hmc'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": true
      }
    ]
  },
  {
    "Name": "$Name_HPM_SMA_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-hmc'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "ForceRecoveryChassisObject": "$Name",
        "I2CBus": "$Bus",
        "Interface": "I2C",
        "MctpEID": "$EID",
        "Name": "$Platform.NamePrefixFW_ProcessorModule_SMA_$Instance",
        "NormalI2CAddress": "0x52",
        "RecoveryGpioName": "BRD$Instance_MCU_RECOVERY_L-O",
        "RecoveryI2CAddress": "0x10",
        "ResetGpioName": "BRD$Instance_MCU_RESET_L-O",
        "Target": "HPM",
        "Type": "MCURecovery",
        "hasChassisPowerSource": false
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^hpm_sma$', 'Generation': 'vr-hmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "Name": "$Name",
        "Pages": [
          {
            "Bus": "$Bus",
            "Idx": "Page1",
            "RegAddr": "0x00",
            "Size": 256,
            "SlaveAddr": "0x0b"
          },
          {
            "Bus": "$Bus",
            "Idx": "Page1",
            "Page": "0x00",
            "RegAddr": "0x00",
            "Size": 256,
            "SlaveAddr": "0x11"
          }
        ],
        "SupportedDumps": [
          "RoT",
          "SMA",
          "CPLD"
        ],
        "Type": "Dump"
      },
      {
        "Address": "$Address",
        "Bus": "$Bus",
        "Name": "$Name",
        "PollingInterval": "1",
        "StaticEndpointID": "$EID",
        "Type": "MCTPI2CTarget"
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 65282,
            "Name": "$Platform.NamePrefixFW_ProcessorModule_SMA_$Instance"
          },
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/component/$Platform.NamePrefixCPLD_$Instance"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 65283,
            "Manufacturer": "Lattice",
            "Name": "$Platform.NamePrefixFW_CPLD_$Instance"
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  }
]
