[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vera-rubin'})",
    "Type": "vr_bmc_cx_sma",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "IRoT.ChassisIRoTResponder",
          "IRoT.FW_ComponentType"
        ],
        "ParameterOverrides": {
          "Device": {
            "Chassis": {
              "ChassisAttributes.LocationCode": "$LOCATION_CODE",
              "ChassisAttributes.LocationContext": "$LOCATION_CONTEXT"
            },
            "Temp": {
              "Name": "IO_Board_SMA_$INSTANCE_NUMBER_Temp_0",
              "MaxValue": 125.0,
              "MinValue": -40.0,
              "PhysicalContext": "Board"
            },
            "LeakDetection": {
              "MaxValue": 3.3,
              "MinValue": 0.0
            }
          }
        }
      },
      {
        "DeviceType": "$Name",
        "Name": "$Name",
        "SupportedDumps": [
          "SMA",
          "GPUDiag"
        ],
        "Type": "Dump"
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x0955:0xcf11:$Port",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "65282": "FW_$Name"
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "MCU",
        "Target": "CX9"
      }
    ]
  },
  {
    "Name": "$Name_LeakDetection",
    "Probe": [
      "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vera-rubin', 'Instance': 1})",
      "OR",
      "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vera-rubin', 'Instance': 3})"
    ],
    "Exposes": [
      {
        "CriticalReactionType": "None",
        "LeakDetectorName": "$ParentChassis_LeakDetector_0",
        "Name": "$ParentChassis_LeakDetector_0_Policy",
        "ReactionDelaySeconds": 0,
        "Type": "LeakDetectionPolicy"
      }
    ],
    "Type": "chassis"
  }
]
