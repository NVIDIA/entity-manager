[
  {
    "Name": "Nvidia VR-NVL144 HMC Policy",
    "Probe": [
      "xyz.openbmc_project.FruDevice({'BUS': 1, 'ADDRESS': 80, 'BOARD_PRODUCT_NAME': '.?E5580.?|.?PG558.?'})",
      "OR",
      "xyz.openbmc_project.FruDevice({'BUS': 10, 'ADDRESS': 80, 'BOARD_PRODUCT_NAME': '.?E5580.?|.?PG558.?'})"
    ],
    "Type": "Platform",
    "PlatformExposes": [
      {
        "Name": "NsmDeviceCapabilityPolicy",
        "Type": "NsmDeviceCapabilityPolicy",
        "GpuSma": {
          "Disable": ["DeviceDiagnostics"]
        },
        "HpmSma": {
          "Disable": ["DeviceDiagnostics", "ModuleWriteProtect"]
        }
      },

      {
        "Name": "DeviceFirmwareUpgradePolicy",
        "Type": "DeviceFirmwareUpgradePolicy",
        "Exclude": [],
        "Gpu": {
          "ImageCopy": true,
          "ImageCopyPolicy": false,
          "InbandUpdate": true
        },
        "GpuSma": {
          "ImageCopy": true,
          "ImageCopyPolicy": false,
          "InbandUpdate": false
        },
        "HpmSma": {
          "ImageCopy": true,
          "ImageCopyPolicy": false,
          "InbandUpdate": false
        },
        "Cpu": {
          "ImageCopy": true,
          "ImageCopyPolicy": false,
          "InbandUpdate": false
        },
        "BmcRot": {
          "ImageCopy": true,
          "ImageCopyPolicy": true,
          "InbandUpdate": false
        },
        "BmcErot": {
          "ImageCopy": true,
          "ImageCopyPolicy": true,
          "InbandUpdate": false
        }
      },

      {
        "Name": "EndpointPollingPolicy",
        "Type": "EndpointPollingPolicy",
        "Usb": {
          "IntervalSeconds": 5
        },
        "I2c": {
          "IntervalSeconds": 1
        },
        "Xrot": {
          "IntervalSeconds": 15
        }
      }
    ]
  }
]
