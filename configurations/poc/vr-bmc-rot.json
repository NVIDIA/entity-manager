[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'AST2700'})",
    "Type": "Device_Configs",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder"
        ],
        "ParameterOverrides": {
          "LocationContext": "$LOCATION_CONTEXT",
          "LocationCode": "$LOCATION_CODE",
          "IRoT": "TRUE"
        }
      }
    ]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'vr-bmc'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "IROT",
        "Name": "IROT_$Platform.BmcName",
        "PhysicalInterface": "",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": true
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'vr-bmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Interface": "$Interface",
        "Name": "MCTPIROT_$Instance",
        "PollingInterval": "15",
        "StaticEndpointID": "$EID",
        "Type": "MCTPXROTTarget"
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/bmc/$Platform.BmcName"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 11,
            "Name": "FW_BMC_Caliptra_0"
          },
          {
            "ComponentIdentifier": 10,
            "Name": "FW_$Platform.BmcName",
            "UpdateOnly": true
          }
        ],
        "MCTPTargetName": "MCTPIROT_$Instance",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  },
  {
    "Name": "GPIO_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'vr-bmc'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "FallingTarget": "hmc-not-ready.target",
        "GPIO": "HMC_READY-I",
        "HideWhenHealthy": true,
        "IsERoT": false,
        "MctpEID": 51,
        "Name": "FW_RECOVERY_HGX_FW_BMC_0",
        "Polarity": "ActiveHigh",
        "RisingTarget": "hmc-ready.target",
        "Type": "GPIORecovery"
      }
    ]
  },
  {
    "Name": "USBDFU_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'vr-bmc'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "Name": "FW_HMC_0",
        "RecoveryGpioName": "HMC_RECOVERY_R-O",
        "RecoveryGpioPolarity": "ActiveHigh",
        "ResetGpioName": "HMC_RST_R_L-O",
        "ResetGpioPolarity": "ActiveLow",
        "SpiMuxGpioName": "HMC_SPI_MUX_R_SEL-O",
        "Type": "USBDFURecovery"
      }
    ]
  }
]
