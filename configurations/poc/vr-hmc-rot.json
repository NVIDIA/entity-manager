  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bmc_rot$', 'Generation': 'vr-hmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "MCTPTargetName": "$Name",
        "Manufacturer": "NVIDIA",
        "Name": "$Name_DevInv",
        "Type": "PLDMDeviceInventory",
        "UpdateInventoryPath": "/xyz/openbmc_project/inventory/system/bmc/$ParentChassis",
        "xyz.openbmc_project.Inventory.Item.SPDMResponder": null
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
