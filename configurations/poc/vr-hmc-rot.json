            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 11,
            "Name": "$Platform.NamePrefixFW_IRoT_BMC_$Instance"
          },
          {
            "ComponentIdentifier": 10,
            "Name": "$Platform.NamePrefixFW_BMC_$Instance",
            "UpdateOnly": true
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
