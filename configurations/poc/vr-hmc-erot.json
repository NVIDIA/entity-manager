[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vera-rubin'})",
    "Type": "erot",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {
          "LocationCode": {
            "Value": "$LocationCode"
          },
          "LocationContext": {
            "Value": "$LocationContext"
          }
        }
      },
      {
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "BMC",
        "Name": "$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_ERoT_BMC_$Instance": 65280,
          "$Platform.NamePrefixFW_BMC_$Instance": 16
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "GlacierCrisis"
      }
    ]
  }
]
