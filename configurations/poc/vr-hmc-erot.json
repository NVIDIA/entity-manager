[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vera-rubin'})",
    "Type": "vr_hmc_erot",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder"
        ],
        "ParameterOverrides": {
          "ImageCopyStateEnabled": false,
          "LocationCode": "ERoT_HMC_$Instance",
          "LocationContext": "$LocationContext"
        }
      },
      {
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "BMC",
        "Name": "$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "65280": "$Platform.NamePrefixFW_ERoT_BMC_$Instance",
          "16": "$Platform.NamePrefixFW_BMC_$Instance"
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "GlacierCrisis"
      }
    ]
  }
]
