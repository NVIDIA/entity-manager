[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bluefield_sma$', 'Generation': 'vera-rubin'})",
    "Type": "vr_bmc_bluefield_sma",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {}
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x1d6b:0x0104:$Port",
        "Type": "PlatformDevice"
      },
      {
        "DeviceType": "$Name",
        "Name": "$Name",
        "SupportedDumps": [
          "SMA",
          "GPUDiag",
          "NetIR=BlueField_NIC_0"
        ],
        "Type": "Dump"
      },
      {
        "BridgePoolEndEID": "$PoolEndEID",
        "BridgePoolStartEID": "$PoolStartEID",
        "BridgedEndpoints": [
          "BF4_0",
          "BF4_1",
          "BF4_2",
          "BF4_3"
        ],
        "Configuration": 1,
        "InterfaceNum": 0,
        "Name": "$Name",
        "PollingInterval": "5",
        "Port": "$Port",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      },
      {
        "CreateInventoryPath": "/xyz/openbmc_project/inventory/system/chassis/IRoT_$Name",
        "MCTPTargetName": "$Name",
        "Manufacturer": "NVIDIA",
        "Name": "$Name_DevInv",
        "Type": "PLDMDeviceInventory",
        "UpdateInventoryPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "xyz.openbmc_project.Inventory.Item.SPDMResponder": null
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 65282,
            "Name": "FW_$Name"
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      },
      {
        "BridgeName": "$Name",
        "Name": "BF4_2",
        "PoolIndex": 2,
        "Type": "MCTPBridgePoolDevice"
      },
      {
        "BridgeName": "$Name",
        "Name": "BF4_3",
        "PoolIndex": 3,
        "Type": "MCTPBridgePoolDevice"
      }
    ]
  },
  {
    "Name": "$Name_BAY_C_SMA_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bluefield_sma$', 'Generation': 'vera-rubin'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "ChassisName": "$Name",
        "ForceRecoveryChassisObject": "$Name",
        "Interface": "USB",
        "MctpEID": "$EID",
        "Name": "FW_$Name",
        "ProductId": "0xCF11",
        "RecoveryGpioName": "BF4_USB_MCU_RECOVERY_L",
        "ResetGpioName": "BF4_USB_MCU_RST_L",
        "Target": "BF4",
        "Type": "MCURecovery",
        "USBPort": ".*-$Port",
        "VendorId": "0x0955",
        "hasChassisPowerSource": false
      }
    ]
  }
]
