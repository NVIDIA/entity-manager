[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^nvme_smm$', 'Generation': 'vera-rubin'})",
    "Exposes": [
      {
        "Address": "$EID",
        "Name": "$Name_Temp_0",
        "Thresholds": [
          {
            "Direction": "greater than",
            "Name": "upper non recoverable",
            "Severity": 4,
            "Value": 77
          },
          {
            "Direction": "greater than",
            "Name": "soft shutdown",
            "Severity": 3,
            "Value": 75
          },
          {
            "Direction": "greater than",
            "Name": "upper critical",
            "Severity": 1,
            "Value": 75
          },
          {
            "Direction": "greater than",
            "Name": "upper non critical",
            "Severity": 0,
            "Value": 72
          },
          {
            "Direction": "less than",
            "Name": "lower non critical",
            "Severity": 0,
            "Value": 5
          }
        ],
        "Type": "NVME1000"
      },
      {
        "Address": "$EID",
        "EntityId": 4,
        "EntityInstance": 3,
        "Name": "$Name_STS_0",
        "PollRate": 1,
        "PowerState": "On",
        "Type": "Nvmem2"
      },
      {
        "ConnectsToType": "SMMPort",
        "Name": "SMM0Port",
        "Type": "DownstreamPort"
      }
    ],
    "Type": "NVMe",
    "xyz.openbmc_project.Inventory.Decorator.Location": {
      "LocationType": "xyz.openbmc_project.Inventory.Decorator.Location.LocationTypes.Slot"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationCode": {
      "LocationCode": "NVMe E1.S SMM Interposer"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationContext": {
      "LocationContext": "$LocationContext"
    },
    "xyz.openbmc_project.Inventory.Item.Drive": {
      "FormFactor": "xyz.openbmc_project.Inventory.Item.Drive.DriveFormFactor.EDSFF_1U_Short"
    },
    "xyz.openbmc_project.MCTP.Endpoint": {
      "EID": "$EID"
    }
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^nvme_smm$', 'Generation': 'vera-rubin'})",
    "Type": "vr_bmc_nvme_smm",
    "Exposes": [
      {
        "Name": "$Name_MCTP",
        "Type": "MCTPEndpoint",
        "IgnoreMessageTypes": "1,5"
      }
    ]
  }
]
