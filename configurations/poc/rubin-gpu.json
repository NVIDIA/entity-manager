[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'vera-rubin'})",
    "Type": "rubin_gpu",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "ModulePowerControl",
          "DRAM_0_Temp_0",
          "ChassisPCIeDevice.LTSSMState",
          "ProcessorPCIe",
          "ChassisIRoTResponder",
          "ChassisRoT"
        ],
        "ParameterOverrides": {
          "Device": {
            "ChassisAssembly.Assembly0": {
              "AssemblyType": "Board"
            },
            "ChassisAssembly.Assembly1": {
              "AssemblyType": "Device"
            },
            "LocationContext": "$LOCATION_CONTEXT",
            "Temp.TEMP_0": {
              "ThermalParameters.UpperFatal": 95.0,
              "ThermalParameters.UpperCritical": 92.0,
              "ThermalParameters.UpperCaution": 90.0
            },
            "Temp.TEMP_1": {
              "ThermalParameters.LowerFatal": -5.0,
              "ThermalParameters.LowerCritical": -4.0,
              "ThermalParameters.LowerCaution": -2.0
            }
          }
        }
      },
      {
        "ConnectsToName": "$Bridge",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "GPU",
        "Name": "$Name",
        "Type": "PlatformDevice",
        "poweredInStandby": false
      },
      {
        "DeviceType": "GPU_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "GPUDiag",
          "NetIR"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "Components": {
          "49152": "$Platform.NamePrefixFW_GPU_$Instance",
          "49168": "$Platform.NamePrefixInfoROM_GPU_$Instance"
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "OCP"
      }
    ]
  }
]
