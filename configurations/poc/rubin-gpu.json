[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'rubin'})",
    "Type": "Device_Configs",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "ModulePowerControl",
          "DRAM_0_Temp_0",
          "ChassisPCIeDevice.LTSSMState",
          "ProcessorPCIe",
          "ChassisIRoTResponder",
          "ChassisRoT"
        ],
        "ParameterOverrides": {
          "Device": {
            "ChassisAssembly.Assembly0": {
              "AssemblyType": "Board"
            },
            "ChassisAssembly.Assembly1": {
              "AssemblyType": "Device"
            },
            "LocationContext": "$LOCATION_CONTEXT",
            "Temp.TEMP_0": {
              "ThermalParameters.UpperFatal": 95.0,
              "ThermalParameters.UpperCritical": 92.0,
              "ThermalParameters.UpperCaution": 90.0
            },
            "Temp.TEMP_1": {
              "ThermalParameters.LowerFatal": -5.0,
              "ThermalParameters.LowerCritical": -4.0,
              "ThermalParameters.LowerCaution": -2.0
            }
          }
        }
      }
    ]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'rubin'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Bridge",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "GPU",
        "Name": "$Name",
        "PhysicalInterface": "",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": false
      }
    ]
  },
  {
    "Name": "$Name_OCP_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'rubin'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "ChassisName": "$Platform.NamePrefixIRoT_GPU_$Instance",
        "ForceRecoveryChassisObject": "$Name",
        "I2CAddress": "$OcpRecoveryI2cAddress",
        "InfoRomName": "$Platform.NamePrefixInfoROM_GPU_$Instance",
        "MctpEID": "$EID",
        "Name": "$Platform.NamePrefixFW_GPU_$Instance",
        "SMAEID": "$BridgeEID",
        "Type": "OCPRecovery",
        "USBPort": "1-$BridgePort",
        "hasChassisPowerSource": true
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'rubin'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "DeviceType": "GPU_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "GPUDiag",
          "NetIR"
        ],
        "Type": "Dump"
      },
      {
        "BridgeName": "$Bridge",
        "Name": "$Name",
        "PoolIndex": "$Position",
        "Type": "MCTPBridgePoolDevice"
      },
      {
        "CreateInventoryPath": "/xyz/openbmc_project/inventory/system/chassis/$Platform.NamePrefixIRoT_GPU_$Instance",
        "MCTPTargetName": "$Name",
        "Manufacturer": "NVIDIA",
        "Name": "$Platform.NamePrefixIRoT_GPU_$Instance_DevInv",
        "Type": "PLDMDeviceInventory",
        "UpdateInventoryPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "xyz.openbmc_project.Inventory.Item.SPDMResponder": null
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 49152,
            "Name": "$Platform.NamePrefixFW_GPU_$Instance"
          },
          {
            "AssociationBackward": [
              "active"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 49168,
            "Name": "$Platform.NamePrefixInfoROM_GPU_$Instance"
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  }
]
