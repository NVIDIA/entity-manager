[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu$', 'Generation': 'vera-rubin'})",
    "Type": "gpu",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "ModulePowerControl",
          "DRAM_0_Temp_0"
        ],
        "ParameterOverrides": {
          "LocationCode": {
            "Value": "$LocationCode"
          },
          "LocationContext": {
            "Value": "$LocationContext"
          }
        }
      },
      {
        "ConnectsToName": "$Bridge",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "GPU",
        "Name": "$Name",
        "Type": "PlatformDevice",
        "poweredInStandby": false
      },
      {
        "DeviceType": "GPU_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "GPUDiag",
          "NetIR"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_GPU_$Instance": 49152
        },
        "FWInventoryOnlyComponent": {
          "$Platform.NamePrefixInfoROM_GPU_$Instance": 49168
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "OCP"
      }
    ]
  }
]
