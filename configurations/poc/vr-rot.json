[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^irot$', 'Generation': 'vera-rubin'})",
    "Type": "vr_rot",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder"
        ],
        "ParameterOverrides": {
          "IRoT": "TRUE"
        }
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "IROT",
        "Name": "IROT_$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_BMC_Caliptra_$Instance": 11,
          "$Platform.NamePrefixFW_BMC_$Instance": 10
        }
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      }
    ]
  },
  {
    "Name": "VRoT_MCTP",
    "Probe": "au.com.codeconstruct.MCTP.Interface1({'Interface': 'mctpvrot0'})",
    "Type": "vr_rot",
    "Exposes": [
      {
        "Interface": "$Interface",
        "Name": "MCTPVROT_0",
        "StaticEndpointID": "100",
        "Type": "MCTPXROTTarget"
      }
    ]
  }
]
