[
  {
    "Name": "$Name",
    "Type": "chassis",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vera-rubin'})",
    "Exposes": [
      {
        "AuxNames": [
          "$Name_Temp_0"
        ],
        "Name": "$Name_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 300,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 105.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 103.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 100.0
          }
        ],
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_0_Temp_0"
        ],
        "Name": "CX_NIC_$Instance_Port_0_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 500,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 72.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 70.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 67.0
          }
        ],
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_1_Temp_0"
        ],
        "Name": "CX_NIC_$Instance_Port_1_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 501,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 72.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 70.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 67.0
          }
        ],
        "Type": "SensorAuxName"
      }
    ],
    "Associations": {
      "parent_chassis": "board/$ParentChassis"
    },
    "xyz.openbmc_project.Inventory.Decorator.Instance": {
      "InstanceNumber": "$Instance"
    },
    "xyz.openbmc_project.Inventory.Decorator.Location": {
      "LocationType": "xyz.openbmc_project.Inventory.Decorator.Location.LocationTypes.Embedded"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationContext": {
      "LocationContext": "$LocationContext"
    },
    "xyz.openbmc_project.Inventory.Decorator.Replaceable": {
      "FieldReplaceable": false
    },
    "xyz.openbmc_project.Inventory.Item.Board": {},
    "xyz.openbmc_project.State.Decorator.Health": {
      "Health": "xyz.openbmc_project.State.Decorator.Health.HealthType.OK"
    }
  },
  {
    "Name": "IRoT_$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vera-rubin'})",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {}
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vera-rubin'})",
    "Type": "cx9_io",
    "Exposes": [
      {
        "DeviceType": "CX_NIC_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "NetIR"
        ],
        "Type": "Dump"
      },
      {
        "ConnectsToName": "$Bridge",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPEndpoint",
        "Name": "$Name",
        "Type": "PlatformDevice",
        "poweredInStandby": false
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "FW_$Name": 1
        },
        "FWInventoryOnlyComponent": {
          "CX_NVConfig_MLNX_$Instance": 4,
          "CX_NVConfig_OEM_$Instance": 3
        },
        "NetworkAdapter": "NIC_0",
        "SensorAuxNames": {
          "$Name": 5,
          "NIC_0": 60,
          "Port_0": 200,
          "Port_1": 201,
          "$Name_Power_0": 50,
          "CX_NIC_$Instance_Port_0_Voltage_0": 400,
          "CX_NIC_$Instance_Port_1_Voltage_0": 401
        },
        "Ports": {
          "200": "$PortName0",
          "201": "$PortName1"
        },
        "PortMaxSpeedMBps": 100000
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "ConnectX"
      }
    ]
  }
]
