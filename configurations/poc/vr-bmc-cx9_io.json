[
  {
    "Name": "$Name",
    "Type": "Device_Configs",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vr-bmc'})",
    "Exposes": [
      {
        "EID": "$EID",
        "Name": "$Name_Association",
        "Type": "MctpEndpointAssociation"
      },
      {
        "AuxNames": [
          "$Name"
        ],
        "Name": "$Name_AUX",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 5,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "NIC_0"
        ],
        "Name": "CX_NIC_$Instance_AUX",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 60,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "Port_0"
        ],
        "Name": "CX_NIC_$Instance_Port_0_AUX",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 200,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "Port_1"
        ],
        "Name": "CX_NIC_$Instance_Port_1_AUX",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 201,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "$Name_Temp_0"
        ],
        "Name": "$Name_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 300,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 105.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 103.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 100.0
          }
        ],
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "$Name_Power_0"
        ],
        "Name": "$Name_Power_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 50,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_0_Temp_0"
        ],
        "Name": "CX_NIC_$Instance_Port_0_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 500,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 72.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 70.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 67.0
          }
        ],
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_0_Voltage_0"
        ],
        "Name": "CX_NIC_$Instance_Port_0_Voltage_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 400,
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_1_Temp_0"
        ],
        "Name": "CX_NIC_$Instance_Port_1_Temp_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 501,
        "ThermalParameters": [
          {
            "Dynamic": false,
            "Name": "UpperFatal",
            "Value": 72.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCritical",
            "Value": 70.0
          },
          {
            "Dynamic": false,
            "Name": "UpperCaution",
            "Value": 67.0
          }
        ],
        "Type": "SensorAuxName"
      },
      {
        "AuxNames": [
          "CX_NIC_$Instance_Port_1_Voltage_0"
        ],
        "Name": "CX_NIC_$Instance_Port_1_Voltage_0",
        "ParentObjPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "SensorId": 401,
        "Type": "SensorAuxName"
      },
      {
        "Association": [
          "associated_port",
          "associated_port",
          "/xyz/openbmc_project/inventory/system/chassis/$Name/NetworkAdapters/NIC_0/Ports/$PortName0"
        ],
        "MaxSpeedMBps": 100000,
        "Name": "CX_NIC_$Instance_Port_0_INFO",
        "PortType": "xyz.openbmc_project.Inventory.Decorator.PortInfo.PortType.BidirectionalPort",
        "SensorId": 200,
        "Type": "SensorPortInfo"
      },
      {
        "Association": [
          "associated_port",
          "associated_port",
          "/xyz/openbmc_project/inventory/system/chassis/$Name/NetworkAdapters/NIC_0/Ports/$PortName1"
        ],
        "MaxSpeedMBps": 100000,
        "Name": "CX_NIC_$Instance_Port_1_INFO",
        "PortType": "xyz.openbmc_project.Inventory.Decorator.PortInfo.PortType.BidirectionalPort",
        "SensorId": 201,
        "Type": "SensorPortInfo"
      }
    ],
    "Parent_Chassis": "/xyz/openbmc_project/inventory/system/board/$ParentChassis",
    "Type": "chassis",
    "xyz.openbmc_project.Inventory.Decorator.Instance": {
      "InstanceNumber": "$Instance"
    },
    "xyz.openbmc_project.Inventory.Decorator.Location": {
      "LocationType": "xyz.openbmc_project.Inventory.Decorator.Location.LocationTypes.Embedded"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationContext": {
      "LocationContext": "$LocationContext"
    },
    "xyz.openbmc_project.Inventory.Decorator.Replaceable": {
      "FieldReplaceable": false
    },
    "xyz.openbmc_project.Inventory.Item.Board": {},
    "xyz.openbmc_project.State.Decorator.Health": {
      "Health": "xyz.openbmc_project.State.Decorator.Health.HealthType.OK"
    }
  },
  {
    "Name": "IRoT_$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vr-bmc'})",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.FabricsEndpoint",
          "Device.FabricsZone",
          "Device.DebugToken",
          "IRoT.FW_ComponentType"
        ],
        "ParameterOverrides": {
          "NVLinkWithNetworkPortAddresses": {
            "Count": "$PORT_COUNT",
            "PortLocationCodeMap": "$PORT_LOCATION_CODE_MAP",
            "PortLocationContext": "$LOCATION_CONTEXT",
            "PortLocationReference": "$PORT_LOCATION_REFERENCE",
            "PortNameMap": "$PORT_NAME_MAP"
          },
          "NetworkAdapter": {
            "Name": "$NETWORK_ADAPTER_NAME"
          }
        }
      }
    ]
  },
  {
    "Name": "$Name_ConnectX_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vr-bmc'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "ChassisName": "IRoT_$Name",
        "EID": "$EID",
        "ForceRecoveryChassisObject": "IRoT_$Name",
        "I2CAddress": "$I2CAddress",
        "I2CBus": "$I2CBus",
        "Name": "FW_$Name",
        "SMAEID": "$BridgeEID",
        "Type": "ConnectXRecovery",
        "hasChassisPowerSource": true
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vr-bmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "DeviceType": "CX_NIC_$Instance",
        "Name": "$Name",
        "SupportedDumps": [
          "NetIR"
        ],
        "Type": "Dump"
      },
      {
        "BridgeName": "$Bridge",
        "Name": "$Name",
        "PoolIndex": "$PoolIndex",
        "Type": "MCTPBridgePoolDevice"
      },
      {
        "MCTPTargetName": "$Name",
        "Manufacturer": "NVIDIA",
        "Name": "$Name_DevInv",
        "Type": "PLDMDeviceInventory",
        "UpdateInventoryPath": "/xyz/openbmc_project/inventory/system/chassis/$Name",
        "xyz.openbmc_project.Inventory.Item.SPDMResponder": null
      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name/NetworkAdapters/NIC_0"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 1,
            "Name": "FW_$Name"
          },
          {
            "AssociationBackward": [
              "active"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 4,
            "Name": "CX_NVConfig_MLNX_$Instance"
          },
          {
            "AssociationBackward": [
              "active"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 3,
            "Name": "CX_NVConfig_OEM_$Instance"
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx9_io$', 'Generation': 'vr-bmc'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Bridge",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPEndpoint",
        "Name": "$Name",
        "PhysicalInterface": "",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": "$PoweredInStandby"
      }
    ]
  }
]
