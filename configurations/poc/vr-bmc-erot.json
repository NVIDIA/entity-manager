[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vera-rubin'})",
    "Type": "erot",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder",
          "Device.FW_ComponentType.AP",
          "Device.FW_ComponentType.EC"
        ],
        "ParameterOverrides": {
          "ImageCopyStateEnabled": false,
          "LocationCode": "$Name",
          "LocationContext": "$Platform.TopChassis/SMM_Interposer_0/SMM_0/$Platform.BmcName",
          "SKUUnsupported": true
        }
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "EROT",
        "Name": "EROT_$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "FW_$Name": 65280,
          "FW_$Platform.BmcName": 16
        }
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "GlacierCrisis"
      }
    ]
  }
]
