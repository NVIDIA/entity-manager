  {
    "Name": "$Name_GPIO_ERoT_Recovery_Devices",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vr-bmc'})",
    "Type": "Recovery_Config",
    "Exposes": [
      {
        "APName": "FW_RECOVERY_HGX_FW_$Platform.BmcName",
        "GPIO": "HMC_EROT_FATAL_ERROR_L-I",
        "HiddenByFPGA": false,
        "HideWhenHealthy": true,
        "I2CAddress": 82,
        "I2CBus": 6,
        "MctpEID": 51,
        "MonitorMode": "Polling",
        "Name": "FW_RECOVERY_HGX_FW_$Name",
        "Polarity": "ActiveLow",
        "PollingIntervalMs": 1000,
        "Target": "enable-hmc-recovery.service",
        "Type": "GPIOERoTRecovery",
        "hasChassisPowerSource": false
      },
      {
        "APName": "FW_BF4_$Platform.BmcName",
        "GPIO": "BF4_S_BMC_EROT_FATAL_ERROR_L-I",
        "HiddenByFPGA": false,
        "HideWhenHealthy": true,
        "I2CAddress": 83,
        "I2CBus": 77,
        "MctpEID": 59,
        "MonitorMode": "Polling",
        "Name": "FW_BF4_$Name",
        "Polarity": "ActiveLow",
        "PollingIntervalMs": 1000,
        "Type": "GPIOERoTRecovery",
        "hasChassisPowerSource": false
      }
    ]
  },
  {
    "Name": "$Name_Platform_Recovery",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vr-bmc'})",
    "Type": "PlatformRecoveryConfiguration",
    "Exposes": [
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "EROT",
        "Name": "EROT_$Platform.BmcName",
        "PhysicalInterface": "",
        "RecoveryLayers": "",
        "ResetGPIO": "",
        "Type": "PlatformDevice",
        "poweredInStandby": true
      }
    ]
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vr-bmc'})",
    "Type": "Device_Configs",
    "Exposes": [
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
