      },
      {
        "Components": [
          {
            "AssociationBackward": [
              "activation"
            ],
            "AssociationEndpoint": [
              "/xyz/openbmc_project/inventory/system/chassis/$Name"
            ],
            "AssociationForward": [
              "inventory"
            ],
            "ComponentIdentifier": 65280,
            "Name": "FW_$Name"
          },
          {
            "ComponentIdentifier": 16,
            "Name": "FW_$Platform.BmcName",
            "UpdateOnly": true
          }
        ],
        "MCTPTargetName": "$Name",
        "Name": "$Name_PLDM",
        "Type": "PLDMFirmwareDevice"
      }
    ]
  },
  {
    "Name": "$Name_Glacier_Crisis_Recovery_Devices",
