[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vr-bmc'})",
    "InstanceNumber": "$INSTANCE",
    "EID": "$EID",
    "Features": [
      {
        "Type": "Telemetry",
        "Disable": [
          "IRoT.ChassisIRoTResponder",
          "IRoT.FW_ComponentType"
        ],
        "PlatformLiterals": {
          "Device": {
            "Chassis": {
              "ChassisAttributes.LocationCode": "$LOCATION_CODE",
              "ChassisAttributes.LocationContext": "$LOCATION_CONTEXT"
            },
            "Temp": {
              "Name": "IO_Board_SMA_$INSTANCE_NUMBER_Temp_0",
              "MaxValue": 125.0,
              "MinValue": -40.0,
              "PhysicalContext": "Board"
            },
            "LeakDetection": {
              "MaxValue": 3.3,
              "MinValue": 0.0
            }
          }
        }
      }
    ]
  }
]
