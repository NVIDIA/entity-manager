[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^rot$', 'Generation': 'vr-bmc'})",
    "InstanceNumber": "$INSTANCE",
    "EID": "$EID",
    "Features": [
      {
        "Type": "Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder"
        ],
        "PlatformLiterals": {
            "LocationContext": "$LOCATION_CONTEXT",
            "LocationCode": "$LOCATION_CODE",
            "IRoT": "TRUE"
        }
      }
    ]
  }
]
