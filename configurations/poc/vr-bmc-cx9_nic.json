          "PortCount": "$PortCount",
          "BoardName": "$BoardName",
          "OpticalModuleResetSupported": "$OpticalModuleResetSupported",
          "OpticalModuleTelemetrySupported": "$OpticalModuleTelemetrySupported",
          "PortNameMap": "$PortNameMap",
