          "Bay_C_CX_NIC_0_Port_0_Voltage_0": 400,
          "Bay_C_CX_NIC_0_Port_1_Voltage_0": 401,
          "$Name_Power_0": 50,
          "Bay_C_CX_NIC_0_Port_0_Temp_0": 500
