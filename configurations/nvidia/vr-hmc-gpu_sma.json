[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^gpu_sma$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Kind": "gpu_sma",
        "InstanceNumber": "$Instance",
        "EID": "$EID",
        "LocationContext": "$LocationContext",
        "LocationCode": "$LocationCode",
        "ProcessorModuleName": "$ParentChassis",
        "ParameterOverrides": {}
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x0955:0xcf11:$Port",
        "Type": "PlatformDevice"
      },
      {
        "DeviceType": "$Name",
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "SMA",
          "GPUDiag"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_GPU_SMA_$Instance": 65282
        },
        "SensorAuxNames": {
          "$Name_Temp_0": 17
        }
      },
      {
        "BridgePoolEndEID": "$PoolEndEID",
        "BridgePoolStartEID": "$PoolStartEID",
        "Configuration": 1,
        "IgnoreEIDs": "$IgnoreEIDs",
        "InterfaceNum": 0,
        "Name": "$Name",
        "PollingInterval": "5",
        "Port": "$Port",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      }
    ]
  }
]
