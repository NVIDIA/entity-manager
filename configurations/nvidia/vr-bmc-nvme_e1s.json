[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^nvme_e1s$', 'Generation': 'vera-rubin'})",
    "Type": "NVMe",
    "Associations": {
      "chassis": "board/IO_Board_$Instance"
    },
    "Exposes": [
      {
        "ConnectsToType": "Backplane$InstancePort",
        "Name": "BPNPort$Instance",
        "Type": "DownstreamPort"
      },
      {
        "Address": "$EID",
        "Name": "$Name_Temp_0",
        "PowerState": "On",
        "Thresholds": [
          {
            "Direction": "greater than",
            "Name": "upper non recoverable",
            "Severity": 4,
            "Value": 77
          },
          {
            "Direction": "greater than",
            "Name": "soft shutdown",
            "Severity": 3,
            "Value": 75
          },
          {
            "Direction": "greater than",
            "Name": "upper critical",
            "Severity": 1,
            "Value": 75
          },
          {
            "Direction": "greater than",
            "Name": "upper non critical",
            "Severity": 0,
            "Value": 72
          },
          {
            "Direction": "less than",
            "Name": "lower non critical",
            "Severity": 0,
            "Value": 5
          }
        ],
        "Type": "NVME1000"
      },
      {
        "Address": "$EID",
        "EntityId": 4,
        "EntityInstance": 3,
        "Name": "$Name_STS_0",
        "PollRate": 1,
        "PowerState": "On",
        "Type": "Nvmem2"
      }
    ],
    "xyz.openbmc_project.Inventory.Decorator.Location": {
      "LocationType": "xyz.openbmc_project.Inventory.Decorator.Location.LocationTypes.Slot"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationCode": {
      "LocationCode": "$LocationCode"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationContext": {
      "LocationContext": "$LocationContext"
    },
    "xyz.openbmc_project.Inventory.Item.NVMe": {
      "Name": "$Name"
    },
    "xyz.openbmc_project.Inventory.Item.Drive": {
      "FormFactor": "xyz.openbmc_project.Inventory.Item.Drive.DriveFormFactor.EDSFF_1U_Short"
    },
    "xyz.openbmc_project.MCTP.Endpoint": {
      "EID": "$EID"
    }
  },
  {
    "Name": "$Name_Platform",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^nvme_e1s$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "nvme_e1s",
    "Exposes": [
      {
        "BridgeName": "$Bridge",
        "Name": "$Name",
        "PoolIndex": "$PoolIndex",
        "Type": "MCTPBridgePoolDevice"
      }
    ]
  },
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^nvme_e1s_backplane$', 'Generation': 'vera-rubin'})",
    "Type": "NVMe",
    "Exposes": [
      {
        "ConnectsToType": "Backplane0Port",
        "Name": "BPNPort0",
        "Type": "DownstreamPort"
      },
      {
        "Address": "$EID",
        "IpmiName": "NVMe_SSD$Instance_Temp",
        "Name": "$Name_Temp_0",
        "PowerState": "On",
        "Thresholds": [
          {
            "Direction": "greater than",
            "Name": "upper non recoverable",
            "Severity": 4,
            "Value": 80
          },
          {
            "Direction": "greater than",
            "Name": "soft shutdown",
            "Severity": 3,
            "Value": 78
          },
          {
            "Direction": "greater than",
            "Name": "upper critical",
            "Severity": 1,
            "Value": 78
          },
          {
            "Direction": "greater than",
            "Name": "upper non critical",
            "Severity": 0,
            "Value": 75
          },
          {
            "Direction": "less than",
            "Name": "lower non critical",
            "Severity": 0,
            "Value": 5
          }
        ],
        "Type": "NVME1000"
      },
      {
        "Address": "$EID",
        "EntityId": 4,
        "EntityInstance": "$Instance + 3",
        "IpmiName": "NVMe_SSD$Instance_STS",
        "Name": "$Name_STS_0",
        "PollRate": 1,
        "PowerState": "On",
        "Type": "Nvmem2"
      }
    ],
    "xyz.openbmc_project.Inventory.Decorator.Location": {
      "LocationType": "xyz.openbmc_project.Inventory.Decorator.Location.LocationTypes.Slot"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationCode": {
      "LocationCode": "$LocationCode"
    },
    "xyz.openbmc_project.Inventory.Decorator.LocationContext": {
      "LocationContext": "Chassis_0/StorageBackplane_0"
    },
    "xyz.openbmc_project.Inventory.Item.NVMe": {
      "Name": "$Name"
    },
    "xyz.openbmc_project.Inventory.Item.Drive": {
      "FormFactor": "xyz.openbmc_project.Inventory.Item.Drive.DriveFormFactor.EDSFF_1U_Short"
    },
    "xyz.openbmc_project.MCTP.Endpoint": {
      "EID": "$EID"
    }
  }
]
