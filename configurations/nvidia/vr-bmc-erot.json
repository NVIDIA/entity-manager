[
    {
        "Exposes": [
            {
                "Name": "$Name",
                "SupportedDumps": [
                    "RoT",
                    "FwAttrs",
                    "HwCheckout"
                ],
                "Type": "Dump"
            },
            {
                "Bus": "$Bus",
                "ChipSelect": "$ChipSelect",
                "Name": "$Name",
                "StaticEndpointID": "$EID",
                "Type": "MCTPSPIDevice"
            },
            {
                "EID": "$EID",
                "InstanceNumber": "$Instance",
                "Kind": "bmc_erot",
                "LocationCode": "$LocationCode",
                "LocationContext": "$LocationContext",
                "Name": "NSM_Telemetry",
                "ParameterOverrides": {},
                "ParentChassis": "$ParentChassis",
                "Type": "NSM_Telemetry"
            },
            {
                "Name": "$Name_PLDM",
                "Type": "PLDMDevice",
                "UpdateableComponents": {
                    "$Platform.NamePrefixFW_BMC_$Instance": 16,
                    "$Platform.NamePrefixFW_ERoT_BMC_$Instance": 65280
                }
            },
            {
                "ConnectsToName": "$Platform.BmcName",
                "DeviceAddress": "MCTP:$EID",
                "DeviceType": "EROT",
                "Name": "EROT_$Platform.BmcName",
                "Type": "PlatformDevice"
            }
        ],
        "Name": "$Name",
        "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vr'})",
        "Type": "NvDevice"
    }
]
