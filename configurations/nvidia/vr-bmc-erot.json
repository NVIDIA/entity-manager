[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "erot",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [
          "Device.ChassisIRoTResponder",
          "Device.FW_ComponentType.AP",
          "Device.FW_ComponentType.EC"
        ],
        "ParameterOverrides": {
          "ImageCopyStateEnabled": {
            "Enabled": false
          },
          "LocationCode": {
            "Value": "$Name"
          },
          "LocationContext": {
            "Value": "$Platform.TopChassis/SMM_Interposer_0/SMM_0/$Platform.BmcName"
          },
          "SKUUnsupported": {
            "Enabled": true
          }
        }
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "EROT",
        "Name": "EROT_$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_ERoT_BMC_$Instance": 65280,
          "$Platform.NamePrefixFW_BMC_$Instance": 16
        }
      },
      {
        "Bus": "$Bus",
        "ChipSelect": "$ChipSelect",
        "Name": "$Name",
        "StaticEndpointID": "$EID",
        "Type": "MCTPSPIDevice"
      }
    ]
  }
]
