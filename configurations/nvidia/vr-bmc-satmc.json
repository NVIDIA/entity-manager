[
  {
    "Name": "BMC_SATMC",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bmc$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "satmc",
    "Exposes": [
      {
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "BMC",
        "Name": "$Platform.BmcName",
        "Type": "PlatformDevice"
      }
    ]
  },
  {
    "Name": "BMC_SATMC_Controller",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bmc$', 'Generation': 'vera-rubin', 'SatelliteHost': '.'})",
    "Type": "NvDevice",
    "Kind": "satmc",
    "Exposes": [
      {
        "AuthType": "None",
        "Hostname": "$SatelliteHost",
        "Name": "sat0",
        "Port": "80",
        "Type": "SatelliteController"
      }
    ]
  }
]
