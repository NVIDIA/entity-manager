          "CX_NIC_$Instance_Port_0_Temp_0": 72.0,
          "CX_NIC_$Instance_Port_1_Temp_0": 72.0
        },
        "UpperCritical": {
          "$Name_Temp_0": 103.0,
          "CX_NIC_$Instance_Port_0_Temp_0": 70.0,
          "CX_NIC_$Instance_Port_1_Temp_0": 70.0
        },
        "UpperCaution": {
          "$Name_Temp_0": 100.0,
          "CX_NIC_$Instance_Port_0_Temp_0": 67.0,
          "CX_NIC_$Instance_Port_1_Temp_0": 67.0
        }
      }
