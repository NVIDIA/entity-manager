[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^storage_backplane_sma$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "storage_backplane_sma",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {}
      },
      {
        "Configuration": 1,
        "InterfaceNum": 0,
        "Name": "StorageSMA_$Instance",
        "PollingInterval": "5",
        "Port": "$Port",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      }
    ]
  }
]
