[
    {
        "Exposes": [
            {
                "DeviceType": "$Name",
                "Name": "$Name",
                "SupportedDumps": [
                    "RoT",
                    "SMA",
                    "GPUDiag"
                ],
                "Type": "Dump"
            },
            {
                "BridgePoolEndEID": "$PoolEndEID",
                "BridgePoolStartEID": "$PoolStartEID",
                "BridgedEndpoints": [
                    "CX_$Instance * 2",
                    "CX_$Instance * 2 + 1",
                    "NVMe_E1S_IO$Instance"
                ],
                "Configuration": 1,
                "IgnoreEIDs": "$IgnoreEIDs",
                "InterfaceNum": 0,
                "Name": "$Name",
                "PollingInterval": "5",
                "Port": "$Port",
                "RootHubPath": "$RootHubPath",
                "StaticEndpointID": "$EID",
                "Type": "MCTPUSBDevice"
            },
            {
                "EID": "$EID",
                "InstanceNumber": "$Instance",
                "Kind": "cx_sma",
                "LeakDetectorChassis": "$LeakDetectorChassis",
                "LocationCode": "SMA_0",
                "LocationContext": "$LocationContext",
                "Name": "NSM_Telemetry",
                "ParameterOverrides": {},
                "ParentChassis": "$ParentChassis",
                "PlatformPrefix": "$Platform.NamePrefix",
                "Type": "NSM_Telemetry"
            },
            {
                "Name": "$Name_PLDM",
                "Type": "PLDMDevice",
                "UpdateableComponents": {
                    "FW_$Name": 65282
                }
            },
            {
                "ConnectsToName": "$Platform.BmcName",
                "DeviceAddress": "MCTP:$EID",
                "DeviceType": "MCTPBridge",
                "Name": "$Name",
                "PhysicalInterface": "usb1:0x0955:0xcf11:$Port",
                "Type": "PlatformDevice"
            }
        ],
        "Name": "$Name",
        "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vr'})",
        "Type": "NvDevice"
    },
    {
        "Exposes": [
            {
                "CriticalReactionType": "None",
                "LeakDetectorName": "$LeakDetectorChassis_LeakDetector_0",
                "Name": "$LeakDetectorChassis_LeakDetector_0_Policy",
                "ReactionDelaySeconds": 0,
                "Type": "LeakDetectionPolicy"
            }
        ],
        "Name": "$Name_LeakDetection",
        "Probe": [
            "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vr', 'LeakDetectorChassis': '.', 'Instance': 1})",
            "OR",
            "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cx_sma$', 'Generation': 'vr', 'LeakDetectorChassis': '.', 'Instance': 3})"
        ],
        "Type": "LeakDetection"
    }
]
