      },
      {
        "Configuration": 1,
        "InterfaceNum": 2,
        "Name": "$Name",
        "PollingInterval": "5",
        "Port": "$Port",
        "RecoveryThreshold": "5",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      },
      {
        "Name": "$Name_Recovery",
        "Type": "Recovery",
        "Method": "USBRCM"
      }
    ]
  },
