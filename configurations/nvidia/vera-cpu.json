[
  {
    "Name": "$Platform.NamePrefixIRoT_CPU_$Instance",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^cpu$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "cpu",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
