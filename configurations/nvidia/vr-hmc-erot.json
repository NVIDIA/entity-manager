[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^erot$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Kind": "hmc_erot",
        "InstanceNumber": "$Instance",
        "EID": "$EID",
        "LocationCode": "$LocationCode",
        "LocationContext": "$LocationContext",
        "ParentChassis": "$ParentChassis",
        "ParameterOverrides": {}
      },
      {
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "BMC",
        "Name": "$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_ERoT_BMC_$Instance": 65280,
          "$Platform.NamePrefixFW_BMC_$Instance": 16
        }
      },
      {
        "Bus": "$Bus",
        "ChipSelect": "$ChipSelect",
        "Name": "$Name",
        "StaticEndpointID": "$EID",
        "Type": "MCTPSPIDevice"
      }
    ]
  }
]
