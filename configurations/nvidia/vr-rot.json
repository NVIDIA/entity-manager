[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^irot$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Kind": "irot",
        "InstanceNumber": "$Instance",
        "EID": "$EID",
        "LocationContext": "$LocationContext",
        "LocationCode": "$LocationCode",
        "ParameterOverrides": {}
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "IROT",
        "Name": "IROT_$Platform.BmcName",
        "Type": "PlatformDevice"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "$Platform.NamePrefixFW_IRoT_BMC_$Instance": 11,
          "$Platform.NamePrefixFW_BMC_$Instance": 10
        }
      },
      {
        "Name": "$Name",
        "SupportedDumps": [
          "RoT",
          "FwAttrs",
          "HwCheckout"
        ],
        "Type": "Dump"
      },
      {
        "Interface": "$Interface",
        "Name": "$Name",
        "PollingInterval": "15",
        "StaticEndpointID": "$EID",
        "Type": "MCTPXROTTarget"
      }
    ]
  }
]
