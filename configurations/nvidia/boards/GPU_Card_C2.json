[
  {
    "Name": "GPU_Card_Devices_$Instance",
    "Probe": "xyz.openbmc_project.Configuration.NvBoard({'Board': '^GPU_Card_C2$'})",
    "Type": "NvDevice",
    "Exposes": [
      {
        "Name": "GPU_SMA_$Instance",
        "Type": "NvDevice",
        "Kind": "gpu_sma",
        "Generation": "vera-rubin",
        "Instance": "$Instance",
        "EID": "$SmaEid",
        "Transport": {
          "Medium": "usb",
          "Port": "$SmaPort",
          "RootHubPath": "$Platform.UsbRootHubPath"
        },
        "Recovery": {
          "RecoveryType": "MCU",
          "RecoveryGpio": "GPU$Instance_MCU_RECOVERY_N-O",
          "ResetGpio": "GPU$Instance_MCU_RST_N-O",
          "Target": "GPU"
        }
      }
    ]
  }
]
