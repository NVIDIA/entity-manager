[
  {
    "Name": "$Name",
    "Probe": "xyz.openbmc_project.Configuration.NvDevice({'Kind': '^bluefield_sma$', 'Generation': 'vera-rubin'})",
    "Type": "NvDevice",
    "Kind": "bluefield_sma",
    "InstanceNumber": "$Instance",
    "EID": "$EID",
    "Exposes": [
      {
        "Name": "NSM_Telemetry",
        "Type": "NSM_Telemetry",
        "Disable": [],
        "ParameterOverrides": {}
      },
      {
        "ConnectsToName": "$Platform.BmcName",
        "DeviceAddress": "MCTP:$EID",
        "DeviceType": "MCTPBridge",
        "Name": "$Name",
        "PhysicalInterface": "usb1:0x1d6b:0x0104:$Port",
        "Type": "PlatformDevice"
      },
      {
        "DeviceType": "$Name",
        "Name": "$Name",
        "SupportedDumps": [
          "SMA",
          "GPUDiag",
          "NetIR=BlueField_NIC_0"
        ],
        "Type": "Dump"
      },
      {
        "BridgeName": "$Name",
        "Name": "BF4_2",
        "PoolIndex": 2,
        "Type": "MCTPBridgePoolDevice"
      },
      {
        "BridgeName": "$Name",
        "Name": "BF4_3",
        "PoolIndex": 3,
        "Type": "MCTPBridgePoolDevice"
      },
      {
        "Name": "$Name_PLDM",
        "Type": "PLDMDevice",
        "UpdateableComponents": {
          "FW_$Name": 65282
        }
      },
      {
        "BridgePoolEndEID": "$PoolEndEID",
        "BridgePoolStartEID": "$PoolStartEID",
        "BridgedEndpoints": [
          "BF4_0",
          "BF4_1",
          "BF4_2",
          "BF4_3"
        ],
        "Configuration": 1,
        "InterfaceNum": 0,
        "Name": "$Name",
        "PollingInterval": "5",
        "Port": "$Port",
        "RootHubPath": "$RootHubPath",
        "StaticEndpointID": "$EID",
        "Type": "MCTPUSBDevice"
      }
    ]
  }
]
