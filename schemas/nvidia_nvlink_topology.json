{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA NVLinkTopology schema",
    "$defs": {
        "NVLinkTopology": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Count": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "Topology": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "NVLinkTopology"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
