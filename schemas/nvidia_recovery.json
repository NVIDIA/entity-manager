{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA recovery Exposes schemas",
    "$defs": {
        "GPIORecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "APBootStatusType": {
                    "type": "string"
                },
                "ChassisName": {
                    "type": "string"
                },
                "FallingTarget": {
                    "type": "string"
                },
                "GPIO": {
                    "type": "string"
                },
                "HiddenByFPGA": {
                    "type": "boolean"
                },
                "HideWhenHealthy": {
                    "type": "boolean"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "IsERoT": {
                    "type": "boolean"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "MctpEid": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "Polarity": {
                    "type": "string"
                },
                "RisingTarget": {
                    "type": "string"
                },
                "Target": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "GPIORecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "GPIOERoTRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "APName": {
                    "type": "string"
                },
                "GPIO": {
                    "type": "string"
                },
                "HiddenByFPGA": {
                    "type": "boolean"
                },
                "HideWhenHealthy": {
                    "type": "boolean"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "MonitorMode": {
                    "type": "string",
                    "enum": ["Interrupt", "Polling"]
                },
                "Name": {
                    "type": "string"
                },
                "Polarity": {
                    "type": "string",
                    "enum": ["ActiveHigh", "ActiveLow"]
                },
                "PollingIntervalMs": {
                    "type": "integer"
                },
                "Target": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "GPIOERoTRecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "GlacierCrisisRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "APBootStatusType": {
                    "type": "string"
                },
                "APEID": {
                    "type": "integer"
                },
                "APName": {
                    "type": "string"
                },
                "ChassisName": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "HiddenByFPGA": {
                    "type": "boolean"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "MctpEid": {
                    "type": "integer"
                },
                "MctpUUID": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "GlacierCrisisRecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                },
                "isRecoverable": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "MCURecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "Interface": {
                    "type": "string"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "NormalI2CAddress": {
                    "type": "string"
                },
                "ProductId": {
                    "type": "string"
                },
                "RecoveryGpioName": {
                    "type": "string"
                },
                "RecoveryI2CAddress": {
                    "type": "string"
                },
                "ResetGpioName": {
                    "type": "string"
                },
                "ResetGpioPolarity": {
                    "description": "Polarity of ResetGpioName. Optional; the MCU recovery tool defaults to ActiveLow when absent.",
                    "enum": ["ActiveHigh", "ActiveLow"]
                },
                "Target": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "MCURecovery"
                },
                "USBPort": {
                    "type": "string"
                },
                "VendorId": {
                    "type": "string"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "OCPRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "InfoRomName": {
                    "type": "string"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "SMAEID": {
                    "type": "integer"
                },
                "Type": {
                    "type": "string",
                    "const": "OCPRecovery"
                },
                "USBPort": {
                    "type": "string"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "USBRCMForceRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ConfigType": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "ResetPins": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "StrapActiveValues": {
                    "type": "array",
                    "items": {
                        "enum": [0, 1],
                        "type": "integer"
                    }
                },
                "StrapDefaultValues": {
                    "type": "array",
                    "items": {
                        "enum": [0, 1],
                        "type": "integer"
                    }
                },
                "StrapPins": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "Type": {
                    "type": "string",
                    "const": "USBRCMForceRecovery"
                }
            },
            "required": ["Name", "Type"]
        },
        "ConnectXRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "EID": {
                    "type": "integer"
                },
                "FlashNotPresentGPIO": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "ResetGPIO": {
                    "type": "string"
                },
                "SMAEID": {
                    "type": "integer"
                },
                "SMAName": {
                    "type": "string"
                },
                "SMAUSBPort": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "ConnectXRecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "USBRCMRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "FMCComponentName": {
                    "type": "string"
                },
                "FWSComponentName": {
                    "type": "string"
                },
                "MctpEID": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "USBRCMRecovery"
                },
                "USBPort": {
                    "type": "string"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "USBDFURecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "FunctionalUsbId": {
                    "description": "USB vid:pid a normally booted HMC presents on the recovery link. Optional; without it the USB DFU recovery tool cannot tell a healthy HMC from a dead one and always attempts recovery.",
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}$"
                },
                "Name": {
                    "type": "string"
                },
                "RecoveryGpioName": {
                    "type": "string"
                },
                "RecoveryGpioPolarity": {
                    "description": "Polarity of RecoveryGpioName. Optional; the USB DFU recovery tool defaults to ActiveHigh when absent.",
                    "enum": ["ActiveHigh", "ActiveLow"]
                },
                "ResetGpioName": {
                    "type": "string"
                },
                "ResetGpioPolarity": {
                    "description": "Polarity of ResetGpioName. Optional; the USB DFU recovery tool defaults to ActiveLow when absent.",
                    "enum": ["ActiveHigh", "ActiveLow"]
                },
                "SpiMuxGpioName": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "USBDFURecovery"
                },
                "UsbPort": {
                    "description": "Kernel USB port path of the HMC (e.g. 2-1.1). Optional; restricts the status probe to that port on platforms with several USB devices.",
                    "type": "string"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": [
                "Name",
                "Type",
                "RecoveryGpioName",
                "ResetGpioName",
                "SpiMuxGpioName"
            ]
        },
        "NVLinkManagementNICRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "EID": {
                    "type": "integer"
                },
                "FlashNotPresentGPIO": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "ResetGPIO": {
                    "type": "string"
                },
                "SMAEID": {
                    "type": "integer"
                },
                "SMAName": {
                    "type": "string"
                },
                "SMAUSBPort": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "NVLinkManagementNICRecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "NVSwitchRecovery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ChassisName": {
                    "type": "string"
                },
                "EID": {
                    "type": "integer"
                },
                "FlashNotPresentGPIO": {
                    "type": "string"
                },
                "ForceRecoveryChassisObject": {
                    "type": "string"
                },
                "I2CAddress": {
                    "type": "integer"
                },
                "I2CBus": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "ResetGPIO": {
                    "type": "string"
                },
                "SMAEID": {
                    "type": "integer"
                },
                "Type": {
                    "type": "string",
                    "const": "NVSwitchRecovery"
                },
                "hasChassisPowerSource": {
                    "type": "boolean"
                }
            },
            "required": ["Name", "Type"]
        },
        "MSTRecoveryPolicy": {
            "description": "Platform facts for code-manager mst-recovery; the other settings of each DeviceType and RecoveryFlow are compiled in. Device records live on the same board as this record.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "DeviceType": {
                    "type": "string",
                    "enum": ["ConnectX", "NVSwitch", "NVLinkManagementNIC"]
                },
                "HealthyEvent": {
                    "description": "Mst flow: post FirmwareNotInRecovery for a healthy device. Default true for NVSwitch and NVLinkManagementNIC.",
                    "type": "boolean"
                },
                "I2CForce": {
                    "description": "Mst flow: read GIS even when a kernel driver owns the address. Default false for NVSwitch and NVLinkManagementNIC.",
                    "type": "boolean"
                },
                "Name": {
                    "type": "string"
                },
                "RecoveryFlow": {
                    "description": "Mst: device groups in parallel; Legacy: CX8 devices one by one; Hold: the one device of this board found through the mapper, FNP held. Default Mst for NVSwitch and NVLinkManagementNIC.",
                    "type": "string",
                    "enum": ["Mst", "Legacy", "Hold"]
                },
                "RecoveryGroups": {
                    "description": "Mst and Legacy flows: device record names of this board; the names in one entry are recovered in parallel, the entries one after the other.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                },
                "SMAPresenceCheck": {
                    "description": "Mst flow: report the SMA MCU state when a device bus is missing. Default true for NVSwitch and NVLinkManagementNIC.",
                    "type": "boolean"
                },
                "Type": {
                    "type": "string",
                    "const": "MSTRecoveryPolicy"
                }
            },
            "required": ["Name", "Type", "DeviceType"]
        },
        "RecoveryPackages": {
            "description": "Model IDs of the recovery PLDM packages of the machine; code-manager reads each <Device>PackageUUID as the Nvidia:<Device>Recovery:<UUID> supported model of that recovery updater when the build sets none.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ConnectXPackageUUID": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                },
                "GlacierPackageUUID": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                },
                "NVLinkManagementNICPackageUUID": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                },
                "NVSwitchPackageUUID": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "RecoveryPackages"
                },
                "USBDFUPackageUUID": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
