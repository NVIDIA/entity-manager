{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$defs": {
        "GPIOLeakDetector": {
            "additionalProperties": false,
            "description": "Configuration for GPIO based Leak Detector.",
            "type": "object",
            "properties": {
                "Name": {
                    "description": "The name of the leak detector.",
                    "type": "string"
                },
                "Type": {
                    "description": "The type of configuration object",
                    "const": "GPIOLeakDetector"
                },
                "SubType": {
                    "description": "The type of leak detector.",
                    "enum": ["LeakSensingCable", "Unknown"]
                },
                "PinName": {
                    "description": "The GPIO pin name for the leak detector.",
                    "type": "string"
                },
                "Polarity": {
                    "description": "The GPIO polarity depicting its active status.",
                    "$ref": "legacy.json#/$defs/Types/Polarity"
                },
                "Level": {
                    "description": "The severity level of the leak detector.",
                    "enum": ["Critical", "Warning"]
                }
            },
            "required": [
                "Name",
                "Type",
                "SubType",
                "PinName",
                "Polarity",
                "Level"
            ]
        },
        "VoltageLeakDetector": {
            "additionalProperties": false,
            "description": "Configuration for voltage/ADC based Leak Detector.",
            "type": "object",
            "properties": {
                "Name": {
                    "description": "The name of the leak detector.",
                    "type": "string"
                },
                "Type": {
                    "description": "The type of configuration object",
                    "const": "VoltageLeakDetector"
                },
                "Device": {
                    "description": "The list of ADC devices backing the detector.",
                    "type": "array"
                },
                "LeakThresholdVolts": {
                    "description": "Voltage at or below which a leak is declared.",
                    "type": "number"
                },
                "MaxValidVolts": {
                    "description": "Maximum voltage considered a valid reading.",
                    "type": "number"
                },
                "MinValidVolts": {
                    "description": "Minimum voltage considered a valid reading.",
                    "type": "number"
                },
                "ShutdownOnLeak": {
                    "description": "Whether a detected leak triggers a shutdown.",
                    "type": "boolean"
                },
                "ShutdownDelaySeconds": {
                    "description": "Delay before shutdown after a leak is detected.",
                    "type": "integer"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
