{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA LeakDetectionPolicy schema",
    "$defs": {
        "LeakDetectionPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "CriticalReactionType": {
                    "type": "string"
                },
                "LeakDetectorName": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "ReactionDelaySeconds": {
                    "type": "integer"
                },
                "Type": {
                    "type": "string",
                    "const": "LeakDetectionPolicy"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
