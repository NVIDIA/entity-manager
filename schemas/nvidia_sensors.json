{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA sensors Exposes schemas",
    "$defs": {
        "LM5066i": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "integer"
                },
                "Labels": {
                    "type": "array"
                },
                "Name": {
                    "type": "string"
                },
                "Thresholds": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "LM5066i"
                },
                "iin_Name": {
                    "type": "string"
                },
                "iin_Offset": {
                    "type": "number"
                },
                "iin_Scale": {
                    "type": "number"
                },
                "pin_Name": {
                    "type": "string"
                },
                "pin_Offset": {
                    "type": "number"
                },
                "pin_Scale": {
                    "type": "number"
                },
                "temp1_Name": {
                    "type": "string"
                },
                "temp1_Offset": {
                    "type": "number"
                },
                "temp1_Scale": {
                    "type": "number"
                },
                "vin_Name": {
                    "type": "string"
                },
                "vin_Offset": {
                    "type": "number"
                },
                "vin_Scale": {
                    "type": "number"
                },
                "vout1_Name": {
                    "type": "string"
                },
                "vout1_Offset": {
                    "type": "number"
                },
                "vout1_Scale": {
                    "type": "number"
                }
            },
            "required": ["Name", "Type"]
        },
        "LM5066I": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "integer"
                },
                "Labels": {
                    "type": "array"
                },
                "Name": {
                    "type": "string"
                },
                "Thresholds": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "LM5066I"
                },
                "iin_Max": {
                    "type": "number"
                },
                "iin_Name": {
                    "type": "string"
                },
                "iin_Offset": {
                    "type": "number"
                },
                "iin_Scale": {
                    "type": "number"
                },
                "pin_Name": {
                    "type": "string"
                },
                "pin_Max": {
                    "type": "number"
                },
                "pin_Offset": {
                    "type": "number"
                },
                "pin_Scale": {
                    "type": "number"
                },
                "temp1_Max": {
                    "type": "number"
                },
                "temp1_Min": {
                    "type": "number"
                },
                "temp1_Name": {
                    "type": "string"
                },
                "temp1_Offset": {
                    "type": "number"
                },
                "temp1_Scale": {
                    "type": "number"
                },
                "vin_Max": {
                    "type": "number"
                },
                "vin_Name": {
                    "type": "string"
                },
                "vin_Offset": {
                    "type": "number"
                },
                "vin_Scale": {
                    "type": "number"
                },
                "vout1_Max": {
                    "type": "number"
                },
                "vout1_Name": {
                    "type": "string"
                },
                "vout1_Offset": {
                    "type": "number"
                },
                "vout1_Scale": {
                    "type": "number"
                }
            },
            "required": ["Name", "Type"]
        },
        "NvidiaFlightDataRecorder": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Model": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "NvidiaFlightDataRecorder"
                }
            },
            "required": ["Name", "Type"]
        },
        "Nvmem2": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "integer"
                },
                "EntityId": {
                    "type": "integer"
                },
                "EntityInstance": {
                    "$ref": "nvidia_topology.json#/$defs/UnsignedOrTemplate"
                },
                "IpmiName": {
                    "$ref": "nvidia_topology.json#/$defs/IpmiName"
                },
                "Name": {
                    "type": "string"
                },
                "PollRate": {
                    "type": "integer"
                },
                "PowerState": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "Nvmem2"
                }
            },
            "required": ["Name", "Type"]
        },
        "Satellite": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "integer"
                },
                "MaxValue": {
                    "type": "number"
                },
                "MinValue": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "Name1": {
                    "type": "string"
                },
                "OffsetValue": {
                    "type": "integer"
                },
                "PollRate": {
                    "type": "integer"
                },
                "PowerState": {
                    "type": "string"
                },
                "SensorType": {
                    "type": "string"
                },
                "StaleBit": {
                    "type": "integer"
                },
                "StaleOffset": {
                    "type": "integer"
                },
                "Thresholds": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "Satellite"
                },
                "ValueType": {
                    "type": "string"
                }
            },
            "required": ["Name", "Type"]
        },
        "SatelliteBus": {
            "description": "The SMBus the satellite sensors of the record are read over.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "description": "7-bit SMBus address of the satellite controller, in hex.",
                    "type": "string",
                    "pattern": "^0x[0-9A-Fa-f]{1,2}$"
                },
                "Bus": {
                    "description": "I2C bus number.",
                    "type": "integer",
                    "minimum": 0
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "const": "SatelliteBus"
                }
            },
            "required": ["Address", "Bus", "Name", "Type"]
        },
        "SatelliteGroup": {
            "description": "A family of satellite sensors that share type, range, thresholds and stale byte; each sensor's stale bit is FirstStaleBit plus its rank by register offset.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "FirstStaleBit": {
                    "description": "Stale bit of the sensor with the lowest register offset.",
                    "type": "integer",
                    "minimum": 0
                },
                "MaxValue": {
                    "type": "number"
                },
                "MinValue": {
                    "type": "number"
                },
                "Name": {
                    "type": "string"
                },
                "PowerState": {
                    "$ref": "legacy.json#/$defs/Types/PowerState"
                },
                "Sensors": {
                    "description": "Sensor name to register offset.",
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "SensorType": {
                    "enum": ["Energy", "Power", "Temperature", "Voltage"]
                },
                "StaleOffset": {
                    "description": "Register offset of the stale byte.",
                    "type": "integer",
                    "minimum": 0
                },
                "Thresholds": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "Direction": {
                                "$ref": "legacy.json#/$defs/Types/Direction"
                            },
                            "Severity": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4
                            },
                            "Value": {
                                "type": "number"
                            }
                        },
                        "required": ["Direction", "Severity", "Value"]
                    }
                },
                "Type": {
                    "const": "SatelliteGroup"
                },
                "ValueType": {
                    "description": "Encoding of the register value.",
                    "enum": ["PLDM"]
                }
            },
            "required": ["Name", "Sensors", "SensorType", "Type"],
            "dependentRequired": {
                "FirstStaleBit": ["StaleOffset"],
                "StaleOffset": ["FirstStaleBit"]
            }
        },
        "SummationSensor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Name": {
                    "type": "string"
                },
                "SensorParams": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "MaxValue": {
                                "type": "number"
                            },
                            "MinValue": {
                                "type": "number"
                            }
                        }
                    }
                },
                "SensorsToSum": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "Type": {
                    "type": "string",
                    "const": "SummationSensor"
                }
            },
            "required": ["Name", "SensorsToSum", "Type"]
        },
        "SensorAuxName": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "integer"
                },
                "AuxNames": {
                    "type": "array"
                },
                "Bus": {
                    "type": "integer"
                },
                "EID": {
                    "type": "integer"
                },
                "IpmiName": {
                    "description": "Short sensor name reported over IPMI by phosphor-host-ipmi.",
                    "maxLength": 16,
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "ParentObjPath": {
                    "type": "string"
                },
                "SensorId": {
                    "type": "integer"
                },
                "ThermalParameters": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "SensorAuxName"
                }
            },
            "required": ["Name", "Type"]
        },
        "SensorPortInfo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Association": {
                    "type": "array"
                },
                "MaxSpeedMBps": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "PortProtocol": {
                    "type": "string"
                },
                "PortType": {
                    "type": "string"
                },
                "SensorId": {
                    "type": "integer"
                },
                "Type": {
                    "type": "string",
                    "const": "SensorPortInfo"
                }
            },
            "required": ["Name", "Type"]
        },
        "TMP1075": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "integer"
                },
                "Name": {
                    "type": "string"
                },
                "Thresholds": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "TMP1075"
                }
            },
            "required": ["Name", "Type"]
        },
        "TMP75C": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": ["string", "integer"]
                },
                "Bus": {
                    "$ref": "nvidia_topology.json#/$defs/UnsignedOrTemplate"
                },
                "IpmiName": {
                    "description": "Short sensor name reported over IPMI by phosphor-host-ipmi.",
                    "maxLength": 16,
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "PhysicalContext": {
                    "type": "string"
                },
                "Thresholds": {
                    "type": "array"
                },
                "Type": {
                    "type": "string",
                    "const": "TMP75C"
                }
            },
            "required": ["Name", "Type"]
        },
        "SensorEventInfo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "EventIds": {
                    "type": "array"
                },
                "ImpactedComponent": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "SensorId": {
                    "type": "integer"
                },
                "Type": {
                    "type": "string",
                    "const": "SensorEventInfo"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
