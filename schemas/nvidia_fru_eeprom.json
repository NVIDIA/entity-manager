{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA FRU_EEPROM schema",
    "$defs": {
        "FRU_EEPROM": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Address": {
                    "type": "string"
                },
                "Bus": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "FRU_EEPROM"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
