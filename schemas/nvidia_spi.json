{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA SPI schema",
    "$defs": {
        "SPI": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Chip": {
                    "type": "string"
                },
                "ChipSelect": {
                    "type": "integer"
                },
                "Gpio": {
                    "type": "array"
                },
                "InventoryObjPath": {
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Programmer": {
                    "type": "string"
                },
                "TargetFirmware": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "SPI"
                },
                "USBPort": {
                    "type": "string"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
