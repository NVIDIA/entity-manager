{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA SPI schema",
    "$defs": {
        "SPI": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Chip": {
                    "type": "string"
                },
                "ChipSelect": {
                    "type": "integer"
                },
                "Device": {
                    "description": "Name of the NvDevice whose USB transport reaches the flash; nvidia-code-mgmt derives USBPort, Programmer and InventoryObjPath from it.",
                    "type": "string"
                },
                "Gpio": {
                    "type": "array"
                },
                "InventoryObjPath": {
                    "type": "string"
                },
                "MuxGpio": {
                    "description": "GPIO line that switches the flash's SPI mux, driven high while programming; nvidia-code-mgmt turns it into the Gpio entry.",
                    "type": "string"
                },
                "Name": {
                    "type": "string"
                },
                "Programmer": {
                    "type": "string"
                },
                "TargetFirmware": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "SPI"
                },
                "USBPort": {
                    "type": "string"
                }
            },
            "required": ["Name", "Type"]
        }
    }
}
