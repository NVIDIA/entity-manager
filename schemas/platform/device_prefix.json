{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "NVIDIA DevicePrefix schema",
    "$defs": {
        "DevicePrefix": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "Name": {
                    "type": "string"
                },
                "Prefix": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "DevicePrefix"
                }
            },
            "required": ["Name", "Prefix", "Type"]
        }
    }
}
